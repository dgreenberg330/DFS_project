# Supabase Configuration
# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api
#
# Note: These are server-only variables (no NEXT_PUBLIC_ prefix)
# to prevent exposure in client-side JavaScript bundles.

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Upstash Redis (for rate limiting)
# Get these from your Upstash console: https://console.upstash.com/
# Optional: Rate limiting will be disabled if not set

UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
